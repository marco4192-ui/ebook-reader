{
  "name": "ebook-reader-pro",
  "version": "1.0.0",
  "description": "E-Book-Reader (EPUB, PDF, TXT, FB2, Comics) mit TTS, Statistiken und Lesezielen. KI-Funktionen erfordern die Server-Version.",
  "author": "marco4192-ui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marco4192-ui/ebook-reader"
  },
  "homepage": "https://marco4192-ui.github.io/ebook-reader/",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "build:static": "bash scripts/build-static.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cap:init": "npx cap init 'eBook Reader Pro' 'com.ebookreader.pro' --web-dir out",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "epubjs": "^0.3.93",
    "framer-motion": "^12.23.2",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "libarchive.js": "^2.0.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "pdfjs-dist": "^5.5.207",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "z-ai-web-dev-sdk": "^0.0.17",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
