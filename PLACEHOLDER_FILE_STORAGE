// ============================================================================
// FILE STORAGE (IndexedDB)
// Speichert Buchdateien (Base64/Data-URLs) außerhalb des localStorage,
// damit das ~5-MB-Limit von localStorage nicht gesprengt wird.
// Fällt graceful auf einen In-Memory-Store zurück, wenn IndexedDB nicht
// verfügbar ist (z. B. Privater Modus).
// ============================================================================

const DB_NAME = 'ebook-reader-files';
const DB_VERSION = 1;
const STORE_NAME = 'files';

/** In-Memory-Fallback, wenn IndexedDB nicht verfügbar ist. */
const memoryStore = new Map<string, string>();
let useMemoryFallback = false;

function isIndexedDBAvailable(): boolean {
  try {
    return typeof indexedDB !== 'undefined' && indexedDB !== null;
  } catch {
    return false;
  }
}

function openDatabase(): Promise<IDBDatabase> {
  return new Promise((resolve, reject) => {
    if (!isIndexedDBAvailable()) {
      reject(new Error('IndexedDB nicht verfügbar'));
      return;
    }
    const request = indexedDB.open(DB_NAME, DB_VERSION);
    request.onupgradeneeded = () => {
      const db = request.result;
      if (!db.objectStoreNames.contains(STORE_NAME)) {
        db.createObjectStore(STORE_NAME);
      }
    };
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error ?? new Error('IndexedDB-Fehler'));
  });
}

async function withStore<T>(
  mode: IDBTransactionMode,
  operation: (store: IDBObjectStore) => IDBRequest<T>
): Promise<T> {
  if (useMemoryFallback || !isIndexedDBAvailable()) {
    throw new Error('IndexedDB nicht verfügbar');
  }
  const db = await openDatabase();
  return new Promise<T>((resolve, reject) => {
    const transaction = db.transaction(STORE_NAME, mode);
    const store = transaction.objectStore(STORE_NAME);
    const request = operation(store);
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
    transaction.oncomplete = () => db.close();
  });
}

/** Datei (Data-URL) unter einer Buch-ID speichern. */
export async function putFile(id: string, file: string): Promise<void> {
  if (useMemoryFallback) {
    memoryStore.set(id, file);
    return;
  }
  try {
    await withStore('readwrite', (store) => store.put(file, id));
  } catch {
    useMemoryFallback = true;
    memoryStore.set(id, file);
  }
}

/** Gespeicherte Datei einer Buch-ID laden (undefined, falls nicht vorhanden). */
export async function getFile(id: string): Promise<string | undefined> {
  if (useMemoryFallback) {
    return memoryStore.get(id);
  }
  try {
    const result = await withStore<string | undefined>('readonly', (store) => store.get(id));
    return result ?? undefined;
  } catch {
    return undefined;
  }
}

/** Datei einer Buch-ID löschen. */
export async function deleteFile(id: string): Promise<void> {
  if (useMemoryFallback) {
    memoryStore.delete(id);
    return;
  }
  try {
    await withStore('readwrite', (store) => store.delete(id));
  } catch {
    // Löschen ist idempotent – Fehler bewusst ignorieren.
  }
}

/** Alle gespeicherten Dateien löschen (z. B. „Alle Daten löschen“). */
export async function clearFiles(): Promise<void> {
  memoryStore.clear();
  if (useMemoryFallback || !isIndexedDBAvailable()) return;
  try {
    await withStore('readwrite', (store) => store.clear());
  } catch {
    // Bewusst ignorieren.
  }
}